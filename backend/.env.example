ANTHROPIC_API_KEY=
# 검색 캐시의 의미 기반(임베딩) 매칭에서만 쓴다 - "gpt" 에이전트 슬롯 자체는
# QWEN_API_KEY가 담당한다(app/agents/gpt.py 참고, 2026-08-15부터).
OPENAI_API_KEY=
# DashScope(Alibaba Cloud) API 키. "gpt" 에이전트 슬롯이 실제로 호출하는 모델은
# Qwen이다 - platform.qwen.ai 또는 dashscope.console.aliyun.com에서 발급.
QWEN_API_KEY=
# 기본값은 국제(비중국 본토, "Model Studio") 엔드포인트. 중국 본토 DashScope
# 계정이면 https://dashscope.aliyuncs.com/compatible-mode/v1 로 바꿀 것.
QWEN_API_BASE=
GEMINI_API_KEY=
# AI 상세검색(app/agents/deepseek.py::extract_facets_from_names)도 이 키를 그대로 쓴다.
DEEPSEEK_API_KEY=
TAVILY_API_KEY=
GOOGLE_MERCHANT_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=

GOOGLE_VISION_API_KEY=

# 소셜 로그인 (Google Client ID는 frontend/.env.example의 VITE_GOOGLE_CLIENT_ID 참고 —
# 백엔드는 access_token으로 유저 정보를 조회해서 client id가 필요 없음)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
SESSION_SECRET_KEY=
